grupo40
comptime integer base, tope;
integer resultado, aux;
singlef promedio;

class origen begin
    integer a, b export to derivada;
    integer metodo(integer x, singlef y)
    integer local;
    begin
        local := x + toi(y);
        ret(local);
    end; export to derivada;
end;

class extra begin
    singlef escala;
end;

class derivada import from origen, extra begin
    integer propio;
    extends origen, extra;
end;

integer function calcular(integer p, integer q, singlef r)
integer temp;
begin
    if (p >= q)
    begin
        temp := p + aux = (q * 2$i);
    end
    else
        temp := toi(r);
    end_if;
    ret(temp);
end;

derivada item;

begin
    base := 10$i;
    tope := 32767$i;
    promedio := 1.25s-2 + .5;
    item[0$i] := base;
    item[1$i] := -32768$i;
    repeat
    begin
        resultado := calcular(item[0$i], aux = (base + 1$i), promedio)[2$i, 1$i, 3$i];
        item.metodo(resultado, promedio)[1$i, 2$i];
        pout("avance
ok");
    end
    until (resultado != 0$i);
    pout(resultado);
end