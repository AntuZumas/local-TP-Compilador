object_declaration -> ID id_list ;
comptime_declaration -> COMPTIME basic_type id_list ;
function_declaration -> basic_type FUNCTION ID ( parameters ) declarations BEGIN function_statements END ;
parameters -> parameter
parameters -> parameters , parameter
parameter -> parameter_type ID
class_declaration -> CLASS ID import_opt BEGIN members END ;
import_opt -> <empty>
import_opt -> IMPORT FROM id_list
members -> member
members -> members member
member -> inheritance
member -> method_declaration
member -> attribute_declaration
attribute_declaration -> basic_type id_list export_opt ;
export_opt -> <empty>
export_opt -> EXPORT TO id_list
method_declaration -> basic_type ID ( parameters ) declarations BEGIN function_statements END ; method_export_opt
method_export_opt -> <empty>
method_export_opt -> EXPORT TO id_list ;
inheritance -> EXTENDS id_list ;
