simple_statement -> assignment ;
assignment -> attribute = expression
assignment -> ID ASSIGN expression
output -> POUT ( STRING )
output -> POUT ( expression )
return_statement -> RET ( expression ) ;
global_block -> BEGIN global_statements END
global_block -> global_statement
function_block -> BEGIN function_statements END
function_block -> function_statement
global_if -> IF ( condition ) global_block global_else END_IF ;
global_else -> <empty>
global_else -> ELSE global_block
function_if -> IF ( condition ) function_block function_else END_IF ;
function_else -> <empty>
function_else -> ELSE function_block
global_repeat -> REPEAT global_block UNTIL ( condition ) ;
function_repeat -> REPEAT function_block UNTIL ( condition ) ;
